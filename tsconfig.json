{
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    // KWin's JavaScript engine lacks newer built-ins such as Array.prototype.flatMap.
    "lib": ["es2018"],
    "types": []
  },
  "include": ["src"]
}
